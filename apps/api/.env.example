# Sentinel — API environment (development defaults).
# Production values are configured in Render as service environment variables.

NODE_ENV=development
PORT=12000
API_URL=http://localhost:12000
DASHBOARD_URL=http://localhost:5173

# PostgreSQL connection string used by the API (and database package).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinel?schema=public

# Discord OAuth2 application credentials.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
REDIRECT_URI=http://localhost:12000/api/auth/callback

# Session and CSRF secrets. Rotate before production.
SESSION_SECRET=dev-only-session-secret-change-me
SESSION_SECRET_PREVIOUS=
CSRF_SECRET=dev-only-csrf-secret-change-me

# Internal API key shared with the Discord bot for the bridge.
SENTINEL_API_KEY=dev-internal-key-0123456789

# Cookie / CSRF toggles.
COOKIE_SECURE=false
CSRF_ENABLED=false
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

SENTINEL_LOG_LEVEL=info