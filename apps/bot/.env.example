# Sentinel — Discord bot environment.

# Discord bot token (never commit a real token).
DISCORD_BOT_TOKEN=

# Comma-separated allowlist of supported guild IDs. Unknown guilds get nothing.
SENTINEL_GUILD_ALLOWLIST=

# Prefix for message commands (`+command`). Slash commands always work.
SENTINEL_PREFIX=!

# Base URL + internal API key for the Sentinel API bridge.
SENTINEL_API_URL=http://localhost:12000
SENTINEL_API_KEY=dev-internal-key-0123456789

# Database connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinel?schema=public

SENTINEL_LOG_LEVEL=info