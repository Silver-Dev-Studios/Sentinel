# Sentinel — dashboard build-time configuration.
# The dashboard is a static React app; it talks to the API through VITE_API_URL.
#
# Production (GitHub Pages + Render API):
#   VITE_API_URL=<your render api url>   e.g. https://sentinel-api.onrender.com
#   VITE_BASE_PATH=<repo subpath>        e.g. /Sentinel/ for
#                                        https://<user>.github.io/Sentinel/
#   Omit VITE_BASE_PATH when hosting at the domain root.

VITE_API_URL=http://localhost:12000
# VITE_BASE_PATH=/